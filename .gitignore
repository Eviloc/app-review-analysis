# 环境密钥（覆盖 .env / .env.bak / .env.local 等变体，保留示例模板）
.env*
!.env.example
# conda / python 虚拟环境
agent-env/
review_analyzer/
venv/
.venv/
# Python 缓存
__pycache__/
*.pyc
*.pyo
# VSCode
.vscode/
# Jupyter
.ipynb_checkpoints/
# 采集原始数据缓存（运行时生成）
cache/*.json
# 保留样例数据（必须提交，供无代理环境演示）
!cache/app_839285684.json
# 程序输出结果（运行生成，不纳入版本管理）
output/
# 系统文件
.DS_Store
Thumbs.db
.cursor/
